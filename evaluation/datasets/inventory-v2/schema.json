{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "quantity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "products"
  ],
  "additionalProperties": false
}